{
  "_comment": "Off-stack transpile scope: only the runtime classes, interfaces, exception, message class and the DDIC of the configuration tables. Everything RAP (ZBP_*, BDEF, projections, DCL, service binding) and all CDS stays out - the transpiler does not parse it and ADT/ABAP Unit validate it instead.",
  "input_folder": "src",
  "input_filter": [
    "zif_apg_.*\\.intf\\.",
    "zcl_apg_.*\\.clas\\.",
    "zcx_apg_error\\.clas\\.",
    "zapg\\.msag\\.",
    "zapg_.*\\.(tabl|dtel|doma)\\."
  ],
  "output_folder": "output",
  "libs": [
    {
      "folder": "offstack/stubs",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/open-abap/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/open-abap-rap"
    },
    {
      "url": "https://github.com/open-abap/open-abap-xco"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": true,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "runtimeError",
    "skip": []
  }
}
