# ---------------------------------------------------------------------------
# ABAP Point Gate — .gitignore
#
# src/ is abapGit-serialized ABAP and is always committed in full.
# Everything ignored here is generated locally or by CI.
# ---------------------------------------------------------------------------

# --- Node / off-stack toolchain --------------------------------------------
node_modules/
npm-debug.log*
.npm/
.node_repl_history
*.tgz

# package-lock.json is intentionally NOT ignored — npm ci in the workflows
# fails without it.

# --- abaplint --------------------------------------------------------------
# Dependencies declared in abaplint.json (steampunk-2302-api) are downloaded
# into /deps at lint time.
deps/
.abaplint/
abaplint-*.log

# --- Transpiler ------------------------------------------------------------
# output/ is regenerated by `npm run transpile` on every run.
output/
*.map.json

# --- Test / coverage artifacts ---------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
junit.xml

# --- Editors & IDEs --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~

# --- Eclipse / ADT workspace leftovers -------------------------------------
.metadata/
.settings/
.project
.classpath
RemoteSystemsTempFiles/

# --- OS --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Local scratch ---------------------------------------------------------
*.local
.env
.env.*
!.env.example
tmp/
scratch/
